---
import siteData from '../content/site.json';

interface Props {
  locale?: 'fr' | 'en';
}

const { locale = 'fr' } = Astro.props;
const { ambition } = siteData[locale];

const terroir_images = [
  {
    src: '/images/univers/ambition-artisans.webp',
    alt: locale === 'en' ? 'Artisans' : 'Artisans',
    label: locale === 'en' ? 'Artisans' : 'Artisans'
  },
  {
    src: '/images/univers/ambition-producteurs.webp',
    alt: locale === 'en' ? 'Producers' : 'Producteurs',
    label: locale === 'en' ? 'Producers' : 'Producteurs'
  },
  {
    src: '/images/univers/ambition-peche.webp',
    alt: locale === 'en' ? 'Fishing' : 'Pêche',
    label: locale === 'en' ? 'Fishing' : 'Pêche'
  },
  {
    src: '/images/univers/ambition-chasse.webp',
    alt: locale === 'en' ? 'Hunting' : 'Chasse',
    label: locale === 'en' ? 'Hunting' : 'Chasse'
  },
];
---

<section id="ambition" class="section-padding bg-ivory">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto text-center">
      <p class="small-caps text-warmgrey mb-4">{ambition.eyebrow}</p>
      <h2 class="text-h2 font-serif mb-6">{ambition.title}</h2>
      <p class="text-body text-warmgrey mb-10 max-w-2xl mx-auto">{ambition.description}</p>

      <!-- Photo collage showcasing future terroir trades -->
      <div class="flex flex-wrap justify-center gap-6 mt-8">
        {
          terroir_images.map((image) => (
            <div class="flex flex-col items-center">
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-lg overflow-hidden shadow-md opacity-80 hover:opacity-100 transition-opacity">
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
              <p class="text-sm text-warmgrey mt-2 font-medium">{image.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
