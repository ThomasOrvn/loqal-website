---
import siteData from '../content/site.json';

const { univers } = siteData;

// Real images for each universe
const images = [
  {
    src: '/images/univers/vignobles.webp',
    alt: 'Vignoble français sous le soleil'
  },
  {
    src: '/images/univers/artisanat.webp',
    alt: 'Artisan au travail dans son atelier'
  },
  {
    src: '/images/univers/peche.webp',
    alt: 'Pêcheur en rivière française'
  },
  {
    src: '/images/univers/chasse.webp',
    alt: 'Forêt française en saison de chasse'
  },
  {
    src: '/images/univers/gastronomie.webp',
    alt: 'Marché de producteurs locaux avec produits frais'
  },
  {
    src: '/images/univers/savoir-faire.webp',
    alt: 'Artisan pratiquant un savoir-faire traditionnel'
  },
];
---

<section id="univers" class="section-padding section-border">
  <div class="container-custom">
    <div class="text-center mb-12">
      <p class="small-caps text-warmgrey mb-4">{univers.eyebrow}</p>
      <h2 class="text-h2 font-serif max-w-3xl mx-auto">{univers.title}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        univers.items.map((item, index) => (
          <div class="card hover:shadow-lg transition-shadow group">
            <div class="aspect-[4/3] bg-warmgrey/10 rounded mb-4 overflow-hidden">
              <img
                src={images[index].src}
                alt={images[index].alt}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <h4 class="font-serif text-xl font-medium mb-2">{item.title}</h4>
            <p class="text-warmgrey text-sm">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
