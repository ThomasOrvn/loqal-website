---
import siteData from '../content/site.json';

const { univers } = siteData;

// Three showcase images
const images = [
  {
    src: '/images/univers/visites-cave.webp',
    alt: 'Visite de cave'
  },
  {
    src: '/images/univers/degustations.webp',
    alt: 'Dégustation de vin'
  },
  {
    src: '/images/univers/vendanges.webp',
    alt: 'Vendanges'
  },
];
---

<section id="univers" class="section-padding section-border">
  <div class="container-custom">
    <div class="text-center mb-8">
      <p class="small-caps text-warmgrey mb-4">{univers.eyebrow}</p>
      <h2 class="text-h2 font-serif max-w-3xl mx-auto mb-4">{univers.title}</h2>
      <p class="text-body text-warmgrey max-w-2xl mx-auto mb-8">{univers.subtitle}</p>
    </div>

    <!-- Pills/badges row -->
    <div class="flex flex-wrap justify-center gap-3 mb-10">
      {
        univers.badges.map((badge) => (
          <span class="inline-block px-4 py-2 rounded-full text-sm font-medium bg-forest text-ivory">
            {badge}
          </span>
        ))
      }
    </div>

    <!-- Three images side by side on desktop, stacked on mobile -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {
        images.map((image) => (
          <div class="aspect-video rounded-lg overflow-hidden">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
