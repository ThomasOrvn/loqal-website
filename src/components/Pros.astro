---
import siteData from '../content/site.json';

const { pros } = siteData;
---

<section id="professionnels" class="section-padding section-border">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <!-- Content -->
      <div class="text-center mb-12">
        <p class="small-caps text-warmgrey mb-4">{pros.eyebrow}</p>
        <h2 class="text-h2 font-serif mb-6">{pros.title}</h2>
        <p class="text-lg text-warmgrey leading-relaxed">
          {pros.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {
          pros.benefits.map((benefit) => (
            <div class="card border-t-4 border-t-olive text-center">
              <h4 class="font-sans font-semibold text-lg mb-3">
                {benefit.title}
              </h4>
              <p class="text-warmgrey text-sm leading-relaxed">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
