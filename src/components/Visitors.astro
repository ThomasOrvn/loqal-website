---
import siteData from '../content/site.json';

interface Props {
  locale?: 'fr' | 'en';
}

const { locale = 'fr' } = Astro.props;
const { visitors } = siteData[locale];
---

<section id="visiteurs" class="section-padding section-border">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <!-- Content -->
      <div class="text-center mb-12">
        <p class="small-caps text-warmgrey mb-4">{visitors.eyebrow}</p>
        <h2 class="text-h2 font-serif mb-6">{visitors.title}</h2>
        <p class="text-lg text-warmgrey leading-relaxed">
          {visitors.description}
        </p>
      </div>

      <!-- Steps in grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        {
          visitors.steps.map((step, index) => (
            <div class="text-center">
              <div class="flex justify-center mb-4">
                <div class="w-12 h-12 rounded-full bg-olive/10 text-olive flex items-center justify-center font-semibold text-lg">
                  {index + 1}
                </div>
              </div>
              <h4 class="font-sans font-semibold mb-2">{step.title}</h4>
              <p class="text-warmgrey text-sm leading-relaxed">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
