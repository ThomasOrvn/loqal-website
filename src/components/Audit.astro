---
import siteContent from '../content/site.json';

interface Props {
  locale?: 'fr' | 'en';
}

const { locale = 'fr' } = Astro.props;
const audit = siteContent[locale].audit;
const homeLink = locale === 'en' ? '/en/' : '/';
---

<section id="audit" class="section-padding section-border bg-warmgrey/5">
  <div class="container-custom">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Gauge -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative w-72 h-72" id="gauge-container" aria-live="polite">
            <!-- SVG Gauge -->
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 200 200" role="img" aria-label={locale === 'en' ? 'Bookability score gauge' : 'Jauge de score de réservabilité'}>
              <!-- Background circle -->
              <circle
                cx="100"
                cy="100"
                r="85"
                fill="none"
                stroke="#e5e5e5"
                stroke-width="15"
              />
              <!-- Colored arc -->
              <circle
                id="gauge-arc"
                cx="100"
                cy="100"
                r="85"
                fill="none"
                stroke="#4C7061"
                stroke-width="15"
                stroke-dasharray="534.07"
                stroke-dashoffset="534.07"
                stroke-linecap="round"
                class="transition-all duration-1000 ease-out"
              />
            </svg>
            <!-- Score display -->
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <div id="score-value" class="text-6xl font-serif text-ink font-bold transition-all duration-300">
                --
              </div>
              <div class="text-warmgrey text-sm mt-1">/100</div>
            </div>
          </div>
        </div>

        <!-- Form and content -->
        <div>
          <div id="form-view">
            <div class="inline-block px-3 py-1 bg-red-500 text-white text-xs font-medium rounded mb-4">
              {audit.badge}
            </div>
            <h2 class="text-h2 font-serif mb-4">
              {audit.title}
            </h2>
            <p class="text-lg text-warmgrey mb-8 leading-relaxed">
              {audit.description}
            </p>

            <form id="audit-form" class="space-y-4">
              <div>
                <label for="activity-name" class="block text-sm font-medium mb-2">
                  {audit.form.activityName} <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="activity-name"
                  name="activityName"
                  required
                  placeholder={locale === 'en' ? 'Estate Dupont, Wood Workshop...' : 'Domaine Dupont, Atelier Bois de la Forêt...'}
                  class="w-full px-4 py-3 border border-borderline rounded focus:outline-none focus:ring-2 focus:ring-olive transition-all"
                />
              </div>

              <div>
                <label for="city" class="block text-sm font-medium mb-2">
                  {audit.form.city} <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  required
                  placeholder={locale === 'en' ? 'Beaune, Annecy...' : 'Beaune, Annecy...'}
                  class="w-full px-4 py-3 border border-borderline rounded focus:outline-none focus:ring-2 focus:ring-olive transition-all"
                />
              </div>

              <div>
                <label for="website-url" class="block text-sm font-medium mb-2">
                  {audit.form.website}
                </label>
                <input
                  type="url"
                  id="website-url"
                  name="url"
                  placeholder={locale === 'en' ? 'https://www.your-estate.com' : 'https://www.votre-domaine.fr'}
                  class="w-full px-4 py-3 border border-borderline rounded focus:outline-none focus:ring-2 focus:ring-olive transition-all"
                />
              </div>

              <button
                type="submit"
                class="w-full px-6 py-3 bg-ink text-ivory font-medium rounded hover:bg-olive transition-colors"
              >
                {audit.form.submit}
              </button>
            </form>

            <p id="audit-error" class="mt-4 text-red-600 text-sm hidden" role="alert"></p>
            
            <!-- Loading messages -->
            <div id="audit-loading" class="mt-6 hidden">
              <div class="p-6 bg-olive/5 border border-olive/20 rounded-lg">
                <p class="text-base text-ink font-medium mb-3 leading-relaxed">
                  {audit.loading.message}
                </p>
                <p id="audit-loading-step" class="text-sm text-olive/80 italic">
                  {audit.loading.steps[0]}
                </p>
              </div>
            </div>

            <p class="mt-4 text-xs text-warmgrey">
              <span id="example-notice" class="hidden">
                {audit.exampleNotice}
              </span>
            </p>
          </div>

          <!-- Results view -->
          <div id="results-view" class="hidden">
            <div class="inline-block px-3 py-1 bg-red-500 text-white text-xs font-medium rounded mb-4">
              {audit.results.badge}
            </div>
            <h3 class="text-2xl font-serif mb-6">{audit.results.title}</h3>

            <div id="criteria-list" class="space-y-4 mb-8">
              <!-- Criteria will be injected here -->
            </div>

            <div class="p-4 bg-olive/5 border border-olive/20 rounded-lg mb-6">
              <p class="text-sm leading-relaxed">
                <strong>{audit.results.helpText.split(':')[0]}:</strong>{audit.results.helpText.split(':')[1]}
              </p>
            </div>

            <a
              href={`${homeLink}#liste-attente`}
              data-tab="pro"
              id="audit-cta"
              class="inline-flex items-center px-6 py-3 bg-ink text-ivory font-medium rounded hover:bg-olive transition-colors"
            >
              {audit.results.cta}
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>

            <button
              id="test-again"
              class="block mt-4 text-sm text-olive hover:underline"
            >
              {audit.results.testAgain}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ loadingSteps: audit.loading.steps, locale }}>
  // Check if endpoint is configured
  const auditEndpoint = import.meta.env.PUBLIC_AUDIT_ENDPOINT || '';
  const isConfigured = auditEndpoint.trim() !== '';

  if (!isConfigured) {
    document.getElementById('example-notice')?.classList.remove('hidden');
  }

  // Store audit data for pre-filling pro form
  let auditData = {
    activityName: '',
    city: '',
    url: ''
  };

  // Loading step rotation - use localized steps from define:vars
  let currentStepIndex = 0;
  let stepRotationInterval: number | null = null;

  function startLoadingSteps() {
    const loadingDiv = document.getElementById('audit-loading');
    const stepDiv = document.getElementById('audit-loading-step');
    const errorDiv = document.getElementById('audit-error');
    
    if (loadingDiv && stepDiv && errorDiv) {
      errorDiv.classList.add('hidden');
      loadingDiv.classList.remove('hidden');
      currentStepIndex = 0;
      stepDiv.textContent = loadingSteps[0];
      
      // Rotate steps every 8 seconds
      stepRotationInterval = window.setInterval(() => {
        currentStepIndex = (currentStepIndex + 1) % loadingSteps.length;
        stepDiv.textContent = loadingSteps[currentStepIndex];
      }, 8000);
    }
  }

  function stopLoadingSteps() {
    const loadingDiv = document.getElementById('audit-loading');
    if (loadingDiv) {
      loadingDiv.classList.add('hidden');
    }
    if (stepRotationInterval) {
      clearInterval(stepRotationInterval);
      stepRotationInterval = null;
    }
  }

  // Get score color
  function getScoreColor(score: number): string {
    if (score < 40) return '#ef4444'; // red
    if (score < 70) return '#f97316'; // orange
    return '#4C7061'; // olive
  }

  // Animate gauge
  function animateGauge(score: number) {
    const arc = document.getElementById('gauge-arc') as SVGCircleElement;
    const scoreValue = document.getElementById('score-value');
    const color = getScoreColor(score);
    
    if (arc) {
      const circumference = 534.07;
      const offset = circumference - (score / 100) * circumference;
      arc.style.strokeDashoffset = offset.toString();
      arc.style.stroke = color;
    }

    // Animate number
    if (scoreValue) {
      let current = 0;
      const duration = 1000;
      const increment = score / (duration / 16);
      
      const counter = setInterval(() => {
        current += increment;
        if (current >= score) {
          current = score;
          clearInterval(counter);
        }
        scoreValue.textContent = Math.round(current).toString();
      }, 16);
    }
  }

  // Show results
  function showResults(data: any) {
    const formView = document.getElementById('form-view');
    const resultsView = document.getElementById('results-view');
    const criteriaList = document.getElementById('criteria-list');

    if (!formView || !resultsView || !criteriaList) return;

    // Stop loading steps
    stopLoadingSteps();

    formView.classList.add('hidden');
    resultsView.classList.remove('hidden');

    // Animate score
    animateGauge(data.score);

    // Display criteria with sources
    criteriaList.innerHTML = data.criteria
      .map((criterion: any) => `
        <div class="flex gap-4 p-4 border border-borderline rounded-lg ${criterion.ok ? 'bg-olive/5' : 'bg-warmgrey/5'}">
          <div class="flex-shrink-0 w-6 h-6 rounded-full ${criterion.ok ? 'bg-olive text-ivory' : 'bg-warmgrey/20 text-warmgrey'} flex items-center justify-center text-sm">
            ${criterion.ok ? '✓' : '✗'}
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-start mb-1">
              <h4 class="font-semibold text-sm">${criterion.label}</h4>
              <span class="text-xs text-warmgrey ml-2">${criterion.points} pts</span>
            </div>
            ${!criterion.ok && criterion.conseil ? `<p class="text-sm text-warmgrey mt-2">${criterion.conseil}</p>` : ''}
            ${criterion.source ? `<a href="${criterion.source}" target="_blank" rel="noopener noreferrer" class="text-xs text-olive hover:underline mt-2 inline-block">Voir la source →</a>` : ''}
          </div>
        </div>
      `)
      .join('');
  }

  // Form submission
  const form = document.getElementById('audit-form') as HTMLFormElement;
  const errorDiv = document.getElementById('audit-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (errorDiv) {
      errorDiv.classList.add('hidden');
      errorDiv.textContent = '';
    }

    const formData = new FormData(form);
    const activityName = formData.get('activityName') as string;
    const city = formData.get('city') as string;
    let url = (formData.get('url') as string) || '';

    // Store for later use
    auditData = { activityName, city, url };

    // Normalize URL if provided
    if (url) {
      url = url.trim();
      if (!url.startsWith('http://') && !url.startsWith('https://')) {
        url = 'https://' + url;
      }
    }

    // Disable form and show loading
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const submitBtnText = submitBtn?.textContent || '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = locale === 'en' ? 'Analysing…' : 'Analyse en cours…';
    }

    // Start loading steps
    startLoadingSteps();

    try {
      if (!isConfigured) {
        // Show example result if not configured
        await new Promise((resolve) => setTimeout(resolve, 2000));
        const exampleCriteria = locale === 'en' ? [
          {
            id: 'booking',
            label: 'Online booking with available slots',
            ok: false,
            points: 35,
            conseil: 'Offer online booking for your visits and tastings with real-time slots, which is exactly what Loqal lets you do simply.',
            source: ''
          },
          {
            id: 'hours',
            label: 'Opening hours/visit times displayed',
            ok: true,
            points: 25,
            conseil: '',
            source: url || ''
          },
          {
            id: 'mobile',
            label: 'Mobile-friendly site',
            ok: true,
            points: 20,
            conseil: '',
            source: ''
          },
          {
            id: 'google',
            label: 'Complete Google Business listing with hours and photos',
            ok: false,
            points: 20,
            conseil: 'Complete your Google Business Profile with detailed hours and quality photos.',
            source: ''
          }
        ] : [
          {
            id: 'booking',
            label: 'Réservation en ligne avec créneaux disponibles',
            ok: false,
            points: 35,
            conseil: 'Proposez la réservation en ligne de vos visites et dégustations avec créneaux en temps réel, c\'est ce que Loqal vous permet de faire simplement.',
            source: ''
          },
          {
            id: 'hours',
            label: 'Horaires/périodes de visite affichés',
            ok: true,
            points: 25,
            conseil: '',
            source: url || ''
          },
          {
            id: 'mobile',
            label: 'Site adapté au mobile',
            ok: true,
            points: 20,
            conseil: '',
            source: ''
          },
          {
            id: 'google',
            label: 'Fiche Google Business complète avec horaires et photos',
            ok: false,
            points: 20,
            conseil: 'Complétez votre fiche Google Business Profile avec des horaires détaillés et des photos de qualité.',
            source: ''
          }
        ];
        showResults({
          score: 45,
          criteria: exampleCriteria
        });
      } else {
        // Call actual endpoint (no timeout - browser default is ~5 minutes)
        const response = await fetch(auditEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({
            activityName: activityName,
            city: city,
            url: url,
            lang: locale,
          }),
        });

        if (!response.ok) {
          throw new Error(locale === 'en' ? 'Audit error' : 'Erreur lors de l\'audit');
        }

        const text = await response.text();
        const data = JSON.parse(text);

        if (data.error) {
          // Log details to console if present
          if (data.details) {
            console.error('Détails de l\'erreur:', data.details);
          }
          throw new Error(data.error);
        }

        showResults(data);
      }
    } catch (error) {
      stopLoadingSteps();
      if (errorDiv) {
        errorDiv.textContent =
          error instanceof Error
            ? error.message
            : (locale === 'en' ? 'An error occurred. Please try again.' : 'Une erreur est survenue. Veuillez réessayer.');
        errorDiv.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtnText;
      }
    }
  });

  // Test again button
  document.getElementById('test-again')?.addEventListener('click', () => {
    const formView = document.getElementById('form-view');
    const resultsView = document.getElementById('results-view');
    const arc = document.getElementById('gauge-arc') as SVGCircleElement;
    const scoreValue = document.getElementById('score-value');

    if (formView && resultsView) {
      resultsView.classList.add('hidden');
      formView.classList.remove('hidden');
    }

    // Reset gauge
    if (arc) {
      arc.style.strokeDashoffset = '534.07';
    }
    if (scoreValue) {
      scoreValue.textContent = '--';
    }

    form?.reset();
  });

  // Handle CTA click to switch to pro tab and pre-fill form
  document.getElementById('audit-cta')?.addEventListener('click', (e) => {
    const target = e.currentTarget as HTMLAnchorElement;
    const tab = target.getAttribute('data-tab');
    if (tab) {
      setTimeout(() => {
        window.dispatchEvent(
          new CustomEvent('switchWaitlistTab', { 
            detail: { 
              tab,
              prefillData: auditData
            } 
          })
        );
      }, 500);
    }
  });
</script>
