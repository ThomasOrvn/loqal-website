---
import siteData from '../content/site.json';

const { hero } = siteData;
---

<section
  class="relative min-h-[90vh] flex items-center justify-center bg-ink text-ivory grain-overlay overflow-hidden"
>
  <!-- Gradient overlay -->
  <div
    class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-ivory to-transparent"
  >
  </div>

  <div class="container-custom relative z-10 text-center py-20">
    <div class="max-w-4xl mx-auto space-y-8">
      <h1 class="text-h1 font-serif animate-fade-up">{hero.title}</h1>
      <p
        class="text-xl md:text-2xl text-ivory/60 max-w-3xl mx-auto animate-fade-up"
        style="animation-delay: 0.1s"
      >
        {hero.subtitle}
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-up"
        style="animation-delay: 0.2s"
      >
        <a
          href="/#liste-attente"
          class="btn-hero group"
        >
          {hero.cta.visitor}
          <svg
            class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
