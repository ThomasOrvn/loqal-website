---
import siteData from '../content/site.json';

const { founder, meta } = siteData;
---

<section id="fondateur" class="section-padding section-border">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto">
      <p class="small-caps text-warmgrey mb-8 text-center">
        {founder.eyebrow}
      </p>

      <div class="flex flex-col md:flex-row gap-8 items-start">
        <!-- Photo -->
        <div class="flex-shrink-0">
          <div
            class="w-48 h-48 rounded-lg overflow-hidden border border-borderline"
          >
            <img
              src="/images/thomas-orvain.webp"
              alt="Thomas Orvain, fondateur de Loqal"
              width="800"
              height="800"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="mt-3 text-sm text-center">
            <span class="font-semibold">{founder.name}</span><br />
            <span class="text-warmgrey text-xs">{founder.title}</span>
          </p>
        </div>

        <!-- Bio -->
        <div class="flex-1">
          <blockquote class="text-lg leading-relaxed">
            <p class="mb-6">{founder.bio}</p>
            <a
              href={`mailto:${meta.emails.thomas}`}
              class="inline-flex items-center text-olive hover:text-ink font-medium transition-colors"
            >
              {meta.emails.thomas}
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
