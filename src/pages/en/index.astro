---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Univers from '../../components/Univers.astro';
import Visitors from '../../components/Visitors.astro';
import Pros from '../../components/Pros.astro';
import Audit from '../../components/Audit.astro';
import Founder from '../../components/Founder.astro';
import FAQ from '../../components/FAQ.astro';
import Ambition from '../../components/Ambition.astro';
import Waitlist from '../../components/Waitlist.astro';
import Footer from '../../components/Footer.astro';
import siteData from '../../content/site.json';

const locale = 'en';
const { meta } = siteData[locale];
---

<Layout title={meta.title} description={meta.description} locale={locale}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Univers locale={locale} />
    <Visitors locale={locale} />
    <Pros locale={locale} />
    <Audit locale={locale} />
    <Founder locale={locale} />
    <FAQ locale={locale} />
    <Ambition locale={locale} />
    <Waitlist locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
