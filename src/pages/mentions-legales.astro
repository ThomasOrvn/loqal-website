---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Mentions légales - Loqal"
  description="Mentions légales du site Loqal"
>
  <Header />
  <main class="min-h-screen">
    <div class="container-custom py-21">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-h2 font-serif mb-8">Mentions légales</h1>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Éditeur du site</h2>
          <p class="text-warmgrey mb-2">
            Le site loqal.fr est édité par Loqal, Thomas Orvain.
          </p>
          <p class="text-warmgrey mb-2">
            <strong>Contact :</strong> <a href="mailto:thomas@loqal.fr" class="text-olive hover:underline">thomas@loqal.fr</a>
          </p>
          <p class="text-warmgrey text-sm">
            [SIRET et adresse à compléter]
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Directeur de la publication</h2>
          <p class="text-warmgrey">
            Thomas Orvain
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Hébergement</h2>
          <p class="text-warmgrey">
            Ce site est hébergé par GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, USA (GitHub Pages).
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Données personnelles</h2>
          <p class="text-warmgrey">
            Les données collectées via les formulaires de liste d'attente et d'audit gratuit sont stockées dans Google Sheets (Google Workspace). Elles sont utilisées uniquement pour vous informer du lancement de Loqal et pour réaliser l'audit de réservabilité. Vos données ne sont jamais vendues à des tiers. Vous disposez d'un droit d'accès, de rectification et de suppression de vos données en nous contactant à <a href="mailto:thomas@loqal.fr" class="text-olive hover:underline">thomas@loqal.fr</a>. Pour plus d'informations, consultez notre <a href="/politique-confidentialite" class="text-olive hover:underline">politique de confidentialité</a>.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Crédits photographiques</h2>
          <p class="text-warmgrey">
            Les photographies utilisées sur ce site proviennent d'<a href="https://unsplash.com" target="_blank" rel="noopener noreferrer" class="text-olive hover:underline">Unsplash</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
