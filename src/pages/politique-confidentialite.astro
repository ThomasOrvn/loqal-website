---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Politique de confidentialité - Loqal"
  description="Politique de confidentialité et protection des données personnelles de Loqal"
>
  <Header />
  <main class="min-h-screen">
    <div class="container-custom py-21">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-h2 font-serif mb-8">Politique de confidentialité</h1>

        <p class="text-lg text-warmgrey mb-8">
          Loqal s'engage à protéger vos données personnelles conformément au Règlement Général sur la Protection des Données (RGPD).
        </p>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Responsable du traitement</h2>
          <p class="text-warmgrey">
            Thomas Orvain / Loqal<br />
            Contact : <a href="mailto:thomas@loqal.fr" class="text-olive hover:underline">thomas@loqal.fr</a>
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Données collectées</h2>
          <p class="text-warmgrey mb-3">
            <strong>Liste d'attente visiteurs :</strong> nom, e-mail, régions d'intérêt (optionnel), centres d'intérêt.
          </p>
          <p class="text-warmgrey mb-3">
            <strong>Liste d'attente professionnels :</strong> nom, e-mail, ville, nom de l'activité, catégorie professionnelle, téléphone (optionnel).
          </p>
          <p class="text-warmgrey">
            <strong>Audit gratuit :</strong> nom de l'activité, ville, site web (optionnel).
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Finalités</h2>
          <p class="text-warmgrey mb-2">
            <strong>Liste d'attente :</strong> vous informer du lancement de Loqal.
          </p>
          <p class="text-warmgrey">
            <strong>Audit :</strong> réaliser l'analyse de réservabilité et de visibilité en ligne de votre activité.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Base légale</h2>
          <p class="text-warmgrey mb-2">
            <strong>Liste d'attente :</strong> votre consentement explicite (article 6.1.a du RGPD).
          </p>
          <p class="text-warmgrey">
            <strong>Audit :</strong> votre demande et notre intérêt légitime à fournir le service demandé (article 6.1.b et 6.1.f du RGPD).
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Sous-traitants</h2>
          <p class="text-warmgrey">
            <strong>Google Workspace / Google Sheets :</strong> stockage des données de liste d'attente et d'audit.<br />
            <strong>Google Gemini :</strong> analyse IA pour l'audit de réservabilité.<br />
            <strong>GitHub Pages :</strong> hébergement du site web.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Durée de conservation</h2>
          <p class="text-warmgrey">
            Vos données sont conservées jusqu'au lancement de Loqal, puis pendant 3 ans maximum sans contact de votre part, ou supprimées immédiatement sur simple demande.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Cookies et traceurs</h2>
          <p class="text-warmgrey">
            Ce site n'utilise aucun cookie publicitaire, de suivi ou d'analyse. Aucun traceur tiers n'est installé.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Pas de revente</h2>
          <p class="text-warmgrey">
            Vos données ne sont jamais vendues, louées ou transmises à des tiers à des fins commerciales.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-serif mb-4">Vos droits</h2>
          <p class="text-warmgrey mb-3">
            Vous disposez d'un droit d'accès, de rectification, de suppression et d'opposition concernant vos données personnelles.
          </p>
          <p class="text-warmgrey mb-3">
            Pour exercer ces droits, contactez-nous à <a href="mailto:thomas@loqal.fr" class="text-olive hover:underline">thomas@loqal.fr</a>.
          </p>
          <p class="text-warmgrey">
            Vous avez également le droit d'introduire une réclamation auprès de la CNIL (<a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="text-olive hover:underline">www.cnil.fr</a>).
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
