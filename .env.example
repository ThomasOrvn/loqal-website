# Loqal Environment Variables

# URL du script Google Apps Script pour la liste d'attente
# Instructions de configuration dans scripts/waitlist-apps-script.gs
#
# ⚠️ IMPORTANT : Ces variables sont PUBLIQUES (préfixe PUBLIC_)
# Elles sont incluses dans le code JavaScript côté client et ne sont pas des secrets.
# Ne mettez JAMAIS de clés API privées ou de tokens secrets ici.

# Endpoint pour la liste d'attente
PUBLIC_WAITLIST_ENDPOINT=https://script.google.com/macros/s/YOUR_WAITLIST_SCRIPT_ID/exec

# Endpoint pour l'audit de réservabilité
PUBLIC_AUDIT_ENDPOINT=https://script.google.com/macros/s/YOUR_AUDIT_SCRIPT_ID/exec
